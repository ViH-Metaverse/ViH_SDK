<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- SECURITY: Removed READ_PRIVILEGED_PHONE_STATE (system-only permission, never grantable to third-party apps) -->

    <!--
        HISPL 12.5 / 12.8 / 12.9 — storage and media permissions removed.

        They existed for two flows that no longer need them: camera capture now writes to the
        internal cache (CaptureFiles) instead of getExternalFilesDir(), and image selection now
        uses the Android Photo Picker instead of ACTION_PICK. Both are permission-free on every
        API level.

        The tools:node="remove" guards are deliberate. These are library manifests: a
        transitive dependency that declares any of these would otherwise merge it straight back
        into every host app, silently re-adding a permission each integrator has to justify in
        their own Play Data safety declaration.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        HISPL 12.6 — SYSTEM_ALERT_WINDOW removed.

        It was declared for the floating chat widget (OverlayService), but that feature has no
        live entry point: nothing in the SDK or the demo app calls startService/
        startForegroundService for it, and DashBoardActivity's checkOverlayPermission() call
        was commented out. The permission was therefore inherited by every host app embedding
        this AAR — and flagged in their store reviews — to support a code path no user could
        reach. Re-declaring it requires re-enabling the feature and reviewing it for
        tapjacking first.
    -->

    <!-- Voicebot (LiveKit) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />


    <queries>
        <intent>
            <action android:name="android.content.Intent.ACTION_VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.content.Intent.ACTION_VIEW" />
            <data android:mimeType="application/*" />
        </intent>
    </queries>

    <application
        android:name=".AppController"
        android:networkSecurityConfig="@xml/vih_network_security_config"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.VihChatbot">

        <activity
            android:name=".ui.activity.CompanyProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.EditSettingsActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".services.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".services.MyFirebaseMessagingService$NotificationDismissedReceiver"
            android:exported="false" />

        <activity
            android:name=".ui.activity.FullScreenViewActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.VideoActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="unspecified" />
        <activity
            android:name=".ui.activity.VoicebotActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.VihChatbot" />

        <activity
            android:name=".ui.activity.home.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" >
            <intent-filter>
                <action android:name="OPEN_CHAT_ACTIVITY" /> <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- SECURITY: DashBoardActivity set to exported=false to prevent unauthorized launches -->
        <activity
            android:name="com.vihmessenger.vihchatbot.ui.activity.home.DashBoardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.activity.splash.SplashActivity"
            android:exported="false" />

        <receiver
            android:name=".services.MyFirebaseMessagingService$OtpCopyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vihmessenger.vihchatbot.services.COPY_OTP" />
            </intent-filter>
        </receiver>

        <!-- SECURITY: ShortcutPinnedReceiver set to exported=false to prevent spoofing -->
        <receiver
            android:name=".services.ShortcutPinnedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vihmessenger.vihchatbot.SHORTCUT_PINNED" />
            </intent-filter>
        </receiver>

        <!--
            HISPL 12.6: OverlayService declaration removed along with SYSTEM_ALERT_WINDOW.
            The class is retained in the source tree (services/OverlayService.kt) but is
            unreachable without this entry, so it cannot start. See the note above.
        -->
    </application>

</manifest>