<?xml version="1.0" encoding="utf-8"?>
<!--
    SECURITY (VAPT F-03) — shipped by the SDK library, not the demo app.

    The previous configuration lived only in `app/src/main/res/xml/`. A library module's
    resources do not carry a `networkSecurityConfig` attribute into consumers, so every
    third-party host app embedding this AAR got default platform trust and no cleartext
    restriction. This file is referenced from the library manifest so the policy merges
    into host apps automatically.

    A host app that already declares its own android:networkSecurityConfig wins the merge —
    integrators who do so must replicate these rules. See docs/sdk-integration-security.md.

    Pins are the AWS CAs fronting the API hosts (issuing intermediate + Amazon Root CA 1 as
    backup) rather than the leaf certificates: ACM auto-renews with a fresh key pair, so
    leaf pins would brick shipped clients at rotation. Rationale in ApiClient.kt.
-->
<network-security-config>

    <!-- Block cleartext (HTTP) traffic by default for all domains. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        Debug builds may trust user-installed CAs so developers can proxy traffic.
        This block is inert in release builds — it keys off android:debuggable.
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

    <!-- Production API -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api.platform.vihresearchlabs.ai</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <!-- Renew before this date; see the rotation note in ApiClient.kt. -->
        <pin-set expiration="2030-08-23">
            <!-- Amazon RSA 2048 M04 (issuing intermediate) -->
            <pin digest="SHA-256">G9LNNAql897egYsabashkzUCTEJkWBzgoEtk8X/678c=</pin>
            <!-- Amazon Root CA 1 (backup, valid to 2037) -->
            <pin digest="SHA-256">++MBgDH5WGvL9Bcn5Be30cRcL0f5O+NyoXuWtQdX1aI=</pin>
        </pin-set>
    </domain-config>

    <!-- Staging API -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api.dev.platform.vihresearchlabs.ai</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <pin-set expiration="2030-08-23">
            <!-- Amazon RSA 2048 M01 (issuing intermediate) -->
            <pin digest="SHA-256">DxH4tt40L+eduF6szpY6TONlxhZhBd+pJ9wbHlQ2fuw=</pin>
            <!-- Amazon Root CA 1 (backup) -->
            <pin digest="SHA-256">++MBgDH5WGvL9Bcn5Be30cRcL0f5O+NyoXuWtQdX1aI=</pin>
        </pin-set>
    </domain-config>

    <!--
        The voice-bot carve-out (VAPT F-04) is gone: v2 calls connect to the per-agent
        wss://…/ws/agent_<id> endpoint carried on each message, so cleartext is no longer
        needed and the base-config block applies. VoicebotActivity still refuses a ws:// URL
        unless the host sets VihSecurity.allowInsecureVoiceTransport = true — a host that
        opts in must also permit cleartext to that domain in its own config.
    -->

</network-security-config>
